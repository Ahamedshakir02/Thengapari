# ThengaPari website — environment variables
# Copy this file to `.env.local` and fill in the real values, then restart `npm run dev`.
# These are Vite client vars (must be prefixed VITE_) — Firebase web config is NOT secret,
# it is safe to expose; access is controlled by Firestore security rules.

# --- Firebase web app config (thengapari-dev) ---
# Firebase console > Project settings > General > "Your apps" > Web app > SDK config.
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=thengapari-dev.firebaseapp.com
VITE_FB_PROJECT_ID=thengapari-dev
VITE_FB_STORAGE_BUCKET=thengapari-dev.appspot.com
VITE_FB_MESSAGING_SENDER_ID=
VITE_FB_APP_ID=

# --- App store links (optional; placeholders used if blank) ---
VITE_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=in.thengapari
VITE_APP_STORE_URL=
